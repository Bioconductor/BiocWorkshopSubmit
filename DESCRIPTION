Package: BiocWorkshopSubmit
Type: Package
Title: Provides a shiny app for workshop submissions
Version: 0.99.11
Authors@R: c(
  person(
    "Marcel", "Ramos", , "marcel.ramos@roswellpark.org",
    c("aut", "cre"), c(ORCID = "0000-0002-3242-0582")
  ),
  person(
    "Alexandru", "Mahmoud", , , "ctb"
